# Copy this file to .env and fill in the values. Never commit .env.

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used for replies. Haiku is the cheapest; claude-sonnet-5-5 or claude-opus-5-5 handle harder conversations better
ANTHROPIC_MODEL=claude-haiku-4-5

# Twilio (https://console.twilio.com) -> Messaging -> Try it out -> Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio WhatsApp sender, for the sandbox usually +14155238886
TWILIO_WHATSAPP_FROM=+14155238886

# The owner's WhatsApp number that gets new bookings and staff alerts (must have joined the sandbox)
OWNER_WHATSAPP=+3556XXXXXXXX

# The public URL Twilio calls, without a trailing slash (e.g. your ngrok or Render URL)
PUBLIC_BASE_URL=
# Keep true in production; set false only for local tests without Twilio
VALIDATE_TWILIO_SIGNATURE=true

# Optional
# DATABASE_PATH=./velox.db
# RESTAURANT_FILE=./restaurant.yaml
