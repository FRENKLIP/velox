# Copy this file to .env and fill in the values. Never commit .env.

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used for replies. Haiku is the cheapest; claude-sonnet-5-5 or claude-opus-5-5 handle harder conversations better
ANTHROPIC_MODEL=claude-haiku-4-5

# Which WhatsApp service to use: twilio or meta
WHATSAPP_PROVIDER=twilio

# Meta WhatsApp Cloud API (https://developers.facebook.com -> your app -> WhatsApp -> API Setup)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Any secret word you make up; type the same word in Meta's webhook settings
META_VERIFY_TOKEN=
# App settings -> Basic -> App secret
META_APP_SECRET=
# META_GRAPH_VERSION=v23.0

# Twilio (https://console.twilio.com) -> Messaging -> Try it out -> Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio WhatsApp sender, for the sandbox usually +14155238886
TWILIO_WHATSAPP_FROM=+14155238886

# The owner's WhatsApp number that gets new bookings and staff alerts (must have joined the sandbox)
OWNER_WHATSAPP=+3556XXXXXXXX

# The public URL Twilio calls, without a trailing slash (e.g. your ngrok or Render URL)
PUBLIC_BASE_URL=
# Keep true in production; set false only for local tests without Twilio
VALIDATE_TWILIO_SIGNATURE=true

# true: answer inside Twilio's webhook request (works with Twilio's WhatsApp trial number).
# false: answer through the Twilio API afterwards (no 15-second limit; needs a sender that allows it).
REPLY_IN_WEBHOOK=true

# Optional
# DATABASE_PATH=./velox.db
# RESTAURANT_FILE=./restaurant.yaml
